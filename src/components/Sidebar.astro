---
import { entryLabel, groupAllDocs, type DocEntry } from '../lib/sections';

interface Props {
  docs: DocEntry[];
  current?: string;
}

const { docs, current } = Astro.props;
const groups = groupAllDocs(docs);
---

<aside class="sidebar">
  <h2>はじめに</h2>
  <ul>
    <li><a href="/docs/" aria-current={current === '' ? 'page' : undefined}>ドキュメント一覧</a></li>
  </ul>
  {
    groups.map((group) => (
      <>
        <h2>{group.label}</h2>
        <ul>
          {group.entries.map((d) => (
            <li>
              <a href={`/docs/${d.slug}`} aria-current={d.slug === current ? 'page' : undefined}>
                {entryLabel(d, group.dir)}
              </a>
            </li>
          ))}
        </ul>
      </>
    ))
  }
</aside>
