---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { loadPublishedDocs } from '../../lib/content';
import { entryLabel, groupAllDocs } from '../../lib/sections';
import { atlasRev, tometRev } from '../../lib/tomet';

const { docs } = await loadPublishedDocs();
const groups = groupAllDocs(docs);
---

<BaseLayout title="ドキュメント — Tomet" nav="docs">
  <div class="layout">
    <Sidebar docs={docs} current="" />

    <main class="tmt-body">
      <div class="page-meta">
        <code>atlas/docs/</code> · <code>tomet/tmtroot/spec/</code>
      </div>
      <h1>Tomet ドキュメント</h1>
      <p class="docs-intro">
        <code>atlas</code>（<code>{atlasRev.label}</code>）の横断ガイドと、<code>tomet</code>（<code>{tometRev.label}</code>）の言語・ツールチェイン仕様の一覧です（全 {docs.length} ページ）。
      </p>

      {
        groups.map((group) => (
          <section class="spec-group">
            <h2 id={group.id}>{group.label}</h2>
            <p class="spec-blurb">{group.blurb}</p>
            <ul class="spec-list">
              {group.entries.map((entry) => (
                <li>
                  <a href={`/docs/${entry.slug}`}>
                    {entry.collection === 'atlas' ? (
                      entryLabel(entry, group.dir)
                    ) : (
                      <code>{entryLabel(entry, group.dir)}</code>
                    )}
                  </a>
                  {entry.description && <span class="spec-desc">{entry.description}</span>}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </main>

    <nav class="toc">
      <h2>トピック</h2>
      <ul>
        {
          groups.map((group) => (
            <li>
              <a href={`#${group.id}`}>{group.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>
