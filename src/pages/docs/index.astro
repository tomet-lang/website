---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { requireCollection } from '../../lib/content';
import { docLabel, groupSpecDocs, type DocEntry } from '../../lib/sections';
import { tometRev } from '../../lib/tomet';

const allDocs = await requireCollection('docs');
const docs: DocEntry[] = allDocs.map((entry) => ({
  slug: entry.data.slug,
  title: entry.data.title,
  sourcePath: entry.data.sourcePath,
  description: entry.data.description,
}));

const groups = groupSpecDocs(docs);
const topicId = (dir: string) => `topic-${dir || 'general'}`;
---

<BaseLayout title="仕様ドキュメント — Tomet" nav="docs">
  <div class="layout">
    <Sidebar docs={docs} current="" />

    <main class="tmt-body">
      <div class="page-meta"><code>tmtroot/spec/</code></div>
      <h1>Tomet 仕様ドキュメント</h1>
      <p class="docs-intro">
        <code>tomet</code>（<code>{tometRev.label}</code>）の <code>tmtroot/spec/</code> から直接レンダリングされた言語・ツールチェイン仕様の一覧です（全 {docs.length} ページ）。
      </p>

      {
        groups.map((group) => (
          <section class="spec-group">
            <h2 id={topicId(group.dir)}>{group.label}</h2>
            <p class="spec-blurb">{group.blurb}</p>
            <ul class="spec-list">
              {group.entries.map((entry) => (
                <li>
                  <a href={`/docs/${entry.slug}`}>
                    <code>{docLabel(entry.slug, group.dir)}</code>
                  </a>
                  {entry.description && <span class="spec-desc">{entry.description}</span>}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </main>

    <nav class="toc">
      <h2>トピック</h2>
      <ul>
        {
          groups.map((group) => (
            <li>
              <a href={`#${topicId(group.dir)}`}>{group.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>
