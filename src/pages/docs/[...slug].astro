---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { loadPublishedDocs, requireRenderedHtml } from '../../lib/content';

export async function getStaticPaths() {
  const { entries, docs } = await loadPublishedDocs();

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, docs },
  }));
}

const { entry, docs } = Astro.props;
const { title, sourcePath, toc, isDataOnly } = entry.data;
const html = isDataOnly ? '' : requireRenderedHtml(entry);
const source = isDataOnly ? entry.body : null;
if (isDataOnly && !source) {
  throw new Error(`Data-only entry "${entry.id}" has no source body.`);
}
---

<BaseLayout title={`${title} — Tomet`} nav="docs">
  <div class="layout">
    <Sidebar docs={docs} current={entry.id} />

    <main class="tmt-body">
      <div class="page-meta">
        <code>{sourcePath}</code>
      </div>

      {
        isDataOnly && (
          <div class="notice">
            <p>
              この文書はデータのみで構成されています。<code>@meta</code> や <code>@config</code>{' '}
              のようなディレクティブは表示上の内容を持たないため、HTML
              としての本文は空になります。ここでは <code>.tmt</code> の原文をそのまま示します。
            </p>
          </div>
        )
      }

      {isDataOnly ? <pre><code>{source}</code></pre> : <Fragment set:html={html} />}
    </main>

    <nav class="toc">
      {
        toc.length > 0 && (
          <>
            <h2>このページ</h2>
            <ul>
              {toc.map((item: { id: string; level: number; text: string }) => (
                <li class={`lvl-${item.level}`}>
                  <a href={`#${item.id}`}>{item.text}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </nav>
  </div>
</BaseLayout>
